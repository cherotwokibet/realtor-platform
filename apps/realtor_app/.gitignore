# Generated per tenant by `melos run app:prepare`; never commit a tenant's files here.
assets/tenant/*
!assets/tenant/.gitkeep
assets/tenant/icons/

# Platform folders are generated (flutter create), then tenant-cli writes the
# tenant-specific parts into them (`tenant flavors`). Never committed.
/android/
/ios/
/web/
/.metadata
/README.md

# Written by `tenant flavors` (one folder + icon/splash config per tenant)
assets/flavors/
flutter_launcher_icons-*.yaml
flutter_native_splash-*.yaml
