{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cherotwokibet/realtor-platform/tenants/schema/tenant.schema.json",
  "title": "Realtor tenant",
  "description": "Everything realtor-specific. One file per realtor in tenants/<id>.json. No brand value may live in code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "brand",
    "domains",
    "apps",
    "firebase",
    "contact",
    "locale",
    "features"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$",
      "description": "Must match the file name."
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "tagline": {
      "type": "string"
    },
    "earbNo": {
      "type": "string",
      "description": "Estate Agents Registration Board number. 'TBC' until supplied."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logo",
        "appIcon",
        "colors",
        "fonts",
        "typeScale",
        "radius",
        "spacingBase"
      ],
      "properties": {
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "description": "Vector sources. Raster icons are generated by `tenant icons <id>` into brand/<id>/generated/ (not committed).",
          "required": [
            "primary",
            "onDark",
            "horizontal",
            "horizontalOnDark",
            "mark",
            "markOnDark",
            "favicon"
          ],
          "properties": {
            "source": {
              "$ref": "#/$defs/assetPath",
              "description": "Original design file (e.g. .ai), kept for the record."
            },
            "primary": {
              "$ref": "#/$defs/svgPath",
              "description": "Stacked lockup for light backgrounds."
            },
            "onDark": {
              "$ref": "#/$defs/svgPath",
              "description": "Stacked lockup for the primary colour or dark backgrounds."
            },
            "horizontal": {
              "$ref": "#/$defs/svgPath",
              "description": "Mark + wordmark in one line: app bars, web headers, email."
            },
            "horizontalOnDark": {
              "$ref": "#/$defs/svgPath"
            },
            "mark": {
              "$ref": "#/$defs/svgPath",
              "description": "Symbol only, for light backgrounds."
            },
            "markOnDark": {
              "$ref": "#/$defs/svgPath",
              "description": "Symbol only, drawn on the primary colour. Used for app icons and splash."
            },
            "favicon": {
              "$ref": "#/$defs/svgPath",
              "description": "Simplified square symbol that reads at 16 px."
            },
            "alt": {
              "$ref": "#/$defs/assetPath",
              "description": "Secondary artwork for marketing only (never in product UI)."
            }
          }
        },
        "appIcon": {
          "$ref": "#/$defs/svgPath",
          "description": "Glyph placed on colors.primary for launcher icons. Usually the same file as logo.markOnDark."
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary",
            "onPrimary",
            "primarySoft",
            "accent",
            "onAccent",
            "accentText",
            "ink",
            "text",
            "textMuted",
            "border",
            "borderStrong",
            "surface",
            "background",
            "surfaceAlt",
            "info",
            "success",
            "error"
          ],
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/hex"
            }
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display",
            "body"
          ],
          "properties": {
            "display": {
              "$ref": "#/$defs/freeFont"
            },
            "body": {
              "$ref": "#/$defs/freeFont"
            }
          }
        },
        "typeScale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caption",
            "body",
            "bodyLarge",
            "title",
            "headline",
            "display"
          ],
          "patternProperties": {
            "^.*$": {
              "type": "number",
              "minimum": 8,
              "maximum": 96
            }
          }
        },
        "radius": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sm",
            "md",
            "pill"
          ],
          "patternProperties": {
            "^.*$": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "spacingBase": {
          "type": "number",
          "enum": [
            4,
            8
          ]
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "share",
        "app",
        "admin"
      ],
      "properties": {
        "share": {
          "$ref": "#/$defs/hostname"
        },
        "app": {
          "$ref": "#/$defs/hostname"
        },
        "admin": {
          "$ref": "#/$defs/hostname"
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "androidId",
        "iosId"
      ],
      "properties": {
        "androidId": {
          "$ref": "#/$defs/bundleId"
        },
        "iosId": {
          "$ref": "#/$defs/bundleId"
        },
        "androidCertSha256": {
          "type": "array",
          "description": "SHA-256 fingerprints of the release (Play App Signing) certificates, for Android App Links. Leave out until the Play Console app exists.",
          "items": {
            "type": "string",
            "pattern": "^([0-9A-F]{2}:){31}[0-9A-F]{2}$"
          },
          "uniqueItems": true
        },
        "androidCertSha1": {
          "type": "array",
          "description": "SHA-1 fingerprints of the same release certificates, for Google sign-in in the store app (prod project).",
          "items": {
            "type": "string",
            "pattern": "^([0-9A-F]{2}:){19}[0-9A-F]{2}$"
          },
          "uniqueItems": true
        },
        "testCerts": {
          "type": "array",
          "description": "Certificates of test builds (docs/android-build.md), registered on the dev and stage projects so sign-in works in them. Fingerprints are public; never add a keystore or password.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sha1",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "sha1": {
                "type": "string",
                "pattern": "^([0-9A-F]{2}:){19}[0-9A-F]{2}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^([0-9A-F]{2}:){31}[0-9A-F]{2}$"
              }
            }
          }
        },
        "appleTeamId": {
          "type": "string",
          "description": "Apple Developer Team ID, for iOS Universal Links. Leave out until the Apple account exists.",
          "pattern": "^[A-Z0-9]{10}$"
        }
      }
    },
    "firebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projects",
        "region"
      ],
      "properties": {
        "projects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dev",
            "stage",
            "prod"
          ],
          "properties": {
            "dev": {
              "$ref": "#/$defs/gcpProject"
            },
            "stage": {
              "$ref": "#/$defs/gcpProject"
            },
            "prod": {
              "$ref": "#/$defs/gcpProject"
            }
          }
        },
        "region": {
          "type": "string",
          "enum": [
            "europe-west1",
            "europe-west4",
            "us-central1",
            "africa-south1"
          ]
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone",
        "whatsapp",
        "email"
      ],
      "properties": {
        "phone": {
          "$ref": "#/$defs/phoneOrTbc"
        },
        "whatsapp": {
          "$ref": "#/$defs/phoneOrTbc"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "extra",
        "currency"
      ],
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "uniqueItems": true
        },
        "currency": {
          "const": "KES"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sale",
        "rent",
        "shortStay",
        "offPlan",
        "mpesa",
        "ads",
        "aiSearch",
        "chat"
      ],
      "patternProperties": {
        "^.*$": {
          "type": "boolean"
        }
      }
    },
    "mpesa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shortcode",
        "type"
      ],
      "properties": {
        "shortcode": {
          "$ref": "#/$defs/secretRef"
        },
        "type": {
          "enum": [
            "paybill",
            "till"
          ]
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "description": "Store listing (P4-s07). Everything is optional: without it `tenant release` writes the listing from the name, tagline and features.",
      "properties": {
        "language": {
          "type": "string",
          "description": "Play language code of the listing, e.g. en-GB.",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "listing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "shortDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "fullDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "description": "Home page words and photos. `hero` sits behind the search; `banner` is the promotion under it (e.g. for owners who want to sell or let).",
      "properties": {
        "hero": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 90
            },
            "text": {
              "type": "string",
              "maxLength": 160
            },
            "image": {
              "type": "string",
              "pattern": "^brand/[a-z0-9-]+/.+\\.(jpg|jpeg|png|webp)$",
              "description": "A photo the realtor may use, at least 1600 px wide. `tenant prepare` resizes it. Leave out for a band in the brand colour."
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "Several photos, shown in turn with a slow cross-fade (one at a time for visitors who turned motion off). Use instead of `image`.",
              "items": {
                "type": "string",
                "pattern": "^brand/[a-z0-9-]+/.+\\.(jpg|jpeg|png|webp)$"
              }
            }
          }
        },
        "banner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 90
            },
            "text": {
              "type": "string",
              "maxLength": 160
            },
            "image": {
              "type": "string",
              "pattern": "^brand/[a-z0-9-]+/.+\\.(jpg|jpeg|png|webp)$",
              "description": "A photo the realtor may use, at least 1600 px wide. `tenant prepare` resizes it. Leave out for a band in the brand colour."
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "description": "Several photos, shown in turn with a slow cross-fade (one at a time for visitors who turned motion off). Use instead of `image`.",
              "items": {
                "type": "string",
                "pattern": "^brand/[a-z0-9-]+/.+\\.(jpg|jpeg|png|webp)$"
              }
            }
          }
        }
      }
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "description": "Map search tiles (P3-s04). Leave out for OpenStreetMap's standard tiles.",
      "properties": {
        "tiles": {
          "type": "string",
          "pattern": "^https://.*\\{z\\}.*\\{x\\}.*\\{y\\}",
          "description": "Raster tile URL template, e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png"
        },
        "attribution": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        }
      },
      "required": [
        "tiles",
        "attribution"
      ]
    },
    "ops": {
      "type": "object",
      "additionalProperties": false,
      "description": "Operations (P8-s02). Who gets an email when an uptime check fails. Leave out to keep the checks without alerts.",
      "properties": {
        "alertEmails": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "email",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
          }
        }
      },
      "required": [
        "alertEmails"
      ]
    }
  },
  "if": {
    "properties": {
      "features": {
        "properties": {
          "mpesa": {
            "const": true
          }
        }
      }
    }
  },
  "then": {
    "required": [
      "mpesa"
    ]
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$",
      "description": "Upper-case 6-digit hex."
    },
    "assetPath": {
      "type": "string",
      "pattern": "^brand/[a-z0-9-]+/([a-z0-9-]+/)?[A-Za-z0-9._-]+$"
    },
    "hostname": {
      "type": "string",
      "pattern": "^([a-z0-9-]+\\.)+[a-z]{2,}$"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "gcpProject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
    },
    "phoneOrTbc": {
      "type": "string",
      "pattern": "^(TBC|\\+254[17][0-9]{8})$"
    },
    "secretRef": {
      "type": "string",
      "pattern": "^secret://[a-z0-9-]+$",
      "description": "Resolved from Secret Manager. Never a real value."
    },
    "freeFont": {
      "type": "string",
      "description": "Only fonts licensed for app, web and Android use. Avenir Next and SF Pro are not allowed.",
      "enum": [
        "Inter",
        "Manrope",
        "Poppins",
        "Metropolis",
        "DM Sans",
        "Plus Jakarta Sans",
        "Outfit",
        "Lato",
        "Montserrat",
        "Nunito Sans",
        "Work Sans",
        "Figtree"
      ]
    },
    "svgPath": {
      "type": "string",
      "pattern": "^brand/[a-z0-9-]+/[A-Za-z0-9._-]+\\.svg$"
    }
  }
}
