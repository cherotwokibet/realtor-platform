{
  "$schema": "./schema/tenant.schema.json",
  "schemaVersion": 1,
  "id": "demo-homes",
  "name": "Demo Homes",
  "tagline": "A home for every budget",
  "earbNo": "TBC",
  "brand": {
    "logo": { "primary": "brand/demo-homes/logo.png" },
    "appIcon": "brand/demo-homes/logo.png",
    "colors": {
      "primary": "#0F5257",
      "onPrimary": "#FFFFFF",
      "primarySoft": "#E1EEEE",
