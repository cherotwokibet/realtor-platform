rules_version = '2';
// Data model v2 (docs/data-model.md). Clients read public data; staff read
// what their role allows. The only client writes are a signed-in user's own
// saved searches. Everything else (listing status, verification, leads,
// viewings, payments, commissions) is written by Cloud Functions with the
// Admin SDK, which bypasses these rules (D7). Tests: functions/src/rules/.
//
// Staff roles are custom claims set by a Function:
//   role: 'owner' | 'manager' | 'agent', and agentId for agents.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isManager() { return role() in ['owner', 'manager']; }
    function isStaff() { return isManager() || role() == 'agent'; }
    function isOwnAgent(agentId) {
      return role() == 'agent' && request.auth.token.get('agentId', '') == agentId;
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'live' || isManager() || isOwnAgent(resource.data.agentId);
      allow write: if false;
    }

    // An agent's edit to a live listing, waiting for a manager (moderateEdit).
    match /listingEdits/{id} {
      allow read: if isManager() || isOwnAgent(resource.data.agentId);
      allow write: if false;
    }

    // Help & feedback messages (personal data): managers only; submitFeedback writes.
    match /feedback/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Adverts: the site reads those switched on; managers read all; saveAd writes.
    match /ads/{id} {
      allow read: if resource.data.active == true || isManager();
      allow write: if false;
    }

    match /agents/{id} {
      allow read: if resource.data.active == true || isStaff();
      allow write: if false;
    }

    match /areas/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /config/tenant {
      allow read: if true;
      allow write: if false;
    }

    // Personal data (Data Protection Act 2019): staff only, agents their own.
    match /leads/{id} {
      allow read: if isManager() || isOwnAgent(resource.data.agentId);
      allow write: if false;
    }

    match /viewings/{id} {
      allow read: if isManager() || isOwnAgent(resource.data.agentId);
      allow write: if false;
    }

    // Off-plan projects (P5-s06): published ones are public; managers see drafts.
    match /projects/{slug} {
      allow read: if resource.data.published == true || isManager();
      allow write: if false;
    }

    // Site pages (P5-s07): published ones are public; managers see drafts.
    match /pages/{slug} {
      allow read: if resource.data.published == true || isManager();
      allow write: if false;
    }

    // Saved-search alerts (D18): the owner reads them, marks them read
    // (readAt only) and clears them; the hourly sweep writes them.
    // A customer's own profile (name, WhatsApp): they read it; only the
    // saveMyProfile Function writes it, after checking the number.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid}/alerts/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && request.resource.data.readAt is timestamp;
    }

    // Phones that turned on push alerts (P4-s03): the owner registers its
    // own FCM token (the document id) and removes it; the sweep reads them.
    match /users/{uid}/devices/{token} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token == token
        && token.size() <= 4096
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.updatedAt == request.time;
    }

    // Reviews (P6-s03): approved ones are public; managers see all.
    // Review links are read only by the Functions.
    match /reviews/{id} {
      allow read: if resource.data.status == 'approved' || isManager();
      allow write: if false;
    }
    match /reviewInvites/{token} {
      allow read, write: if false;
    }

    // Agents' time off (P5-s05): addAgentBlock / removeAgentBlock write it.
    match /agentBlocks/{id} {
      allow read: if isManager() || isOwnAgent(resource.data.agentId);
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Staff roles (mirror of the custom claims, set by setStaffRole).
    match /staff/{uid} {
      allow read: if isManager() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // Staff actions, written by Functions in the same transaction as the change.
    match /audit/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    // Photos that match another listing's (P6-s05), for managers to review.
    // The hash index behind it (photoHashes) has no rule, so it stays closed.
    match /photoFlags/{id} {
      allow read: if isManager();
      allow write: if false;
    }

    match /savedSearches/{id} {
      // The shape functions/src/model/schema.ts expects, with bounded sizes:
      // the saved search sweep reads these, so junk must not get in.
      // A drawn area, as the search link writes it: 3 to 20 corners
      // "lat,lng" joined by "~", each to at most 6 decimal places.
      function validArea(p) {
        return p is string && p.size() <= 600
          && p.matches('^(-?[0-9]{1,3}([.][0-9]{1,6})?,-?[0-9]{1,3}([.][0-9]{1,6})?~){2,19}-?[0-9]{1,3}([.][0-9]{1,6})?,-?[0-9]{1,3}([.][0-9]{1,6})?$');
      }
      function validFilters(f) {
        return f is map
          && f.keys().hasOnly(['purpose', 'types', 'areas', 'minBeds', 'maxPriceKES', 'poly'])
          && f.purpose in ['rent', 'sale', 'short-stay']
          && (!('types' in f) || (f.types is list && f.types.size() <= 12))
          && (!('areas' in f) || (f.areas is list && f.areas.size() <= 20))
          && (!('minBeds' in f) || (f.minBeds is int && f.minBeds >= 0 && f.minBeds <= 20))
          && (!('maxPriceKES' in f) || (f.maxPriceKES is int && f.maxPriceKES >= 0))
          && (!('poly' in f) || validArea(f.poly));
      }
      function valid(d) {
        return d.keys().hasOnly(['userId', 'filters', 'channels', 'lastNotifiedAt', 'createdAt'])
          && d.userId == request.auth.uid
          && validFilters(d.filters)
          && d.channels is list && d.channels.size() > 0 && d.channels.size() <= 3
          && d.channels.hasOnly(['inbox', 'push', 'email', 'whatsapp']);
      }
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && valid(request.resource.data)
        && request.resource.data.lastNotifiedAt == null
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['filters', 'channels']);
    }

    // Anything not listed above stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
