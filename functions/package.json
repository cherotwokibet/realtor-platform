{
  "name": "@realtor-platform/functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'lib/**/*.test.js'",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions",
    "seed": "npm run build && node lib/seed/run.js",
    "staff:owner": "npm run build && node lib/staff/owner.js",
    "test:rules": "npm run build && node --test --test-concurrency=1 'lib/**/*.rules-test.js'",
    "test:emulator": "npm run build && node --test --test-concurrency=1 'lib/**/*.emulator-test.js'",
    "test:typesense": "npm run build && node --test --test-concurrency=1 'lib/**/*.typesense-test.js'"
  },
  "dependencies": {
    "blurhash": "^2.0.5",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.35.5",
    "typesense": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.5",
    "firebase": "^12.19.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
